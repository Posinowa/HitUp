# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# fvm keeps a machine-local SDK symlink here. `.fvmrc` itself is tracked, since
# it is where the pinned Flutter version is written and CI reads it.
.fvm/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
# The widget preview tool generates a whole scaffold project here: its own
# .dart_tool, its own build output, an IDE module file. It is 15 MB of
# generated content and it appears the first time anyone opens a preview, so
# it has to be listed rather than left to the entries above. `.dart_tool/` and
# `/build/` do not reach it: the first is unanchored but the second is, and
# neither covers a nested project root.
.widget_preview/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Secrets & credentials (NEVER commit)
.env
.env.*
!.env.example
**/service-account*.json
**/firebase-adminsdk*.json
**/*-firebase-adminsdk-*.json
**/google-services-desktop.json
credentials*.json
!assets/**/credentials*.json
*.jks
*.keystore
*.p12
*.pfx
*.pem
*.key
*.p8
*.mobileprovision
**/Cloudflare*Secret*
**/r2*secret*
**/r2*access*key*

